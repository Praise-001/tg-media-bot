# Required: token from @BotFather
BOT_TOKEN=

# Max size of a file to send. 50 is Telegram's cloud Bot API limit.
MAX_FILE_MB=50

# How many downloads may run at the same time
MAX_CONCURRENT=4

# Give up on a download after this many seconds
DOWNLOAD_TIMEOUT=120

# Optional: comma-separated Telegram user IDs allowed to use the bot (empty = everyone)
ALLOWED_USER_IDS=

# Who can use /stats (usage report). Your numeric Telegram user ID: send /id to the bot.
# Several admins: 123456789,987654321
ADMIN_IDS=

# Where usage stats are saved. Docker sets this to /data/stats.db (kept in ./data).
# Leave empty when running locally.
STATS_DB_PATH=

# Optional: Netscape-format cookies file (helps with Instagram/Facebook/age-restricted posts)
# In Docker: COOKIES_FILE=/data/cookies.txt
COOKIES_FILE=

# Update yt-dlp and gallery-dl on every start (Docker). 1 = yes, 0 = no
AUTO_UPDATE=1

# Optional: only if you run your own local Telegram Bot API server (allows files up to 2000 MB)
TELEGRAM_API_URL=

# Leave off unless you know you want every domain yt-dlp supports
ALLOW_ANY_DOMAIN=false

# How many link -> file_id results to remember for instant repeats
CACHE_SIZE=500
